// Scroll speed in wheel steps per second. &msc emits every 16 ms, so 63/s gives
// exactly one wheel step per encoder detent (63 * 16 / 1000 = 1).
#define ZMK_POINTING_DEFAULT_SCRL_VAL 63

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    behaviors {
        // Left encoder: scroll up/down
        scroll_vert: scroll_vert {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        // Right encoder: scroll left/right
        scroll_horz: scroll_horz {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };
    };

    macros {
        // German dead keys: send the accent followed by space so the character appears immediately
        caret: caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp SPACE>;
        };

        backtick: backtick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL) &kp SPACE>;
        };

        acute: acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp SPACE>;
        };
    };

    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC         &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                             &kp N6     &kp N7     &kp N8         &kp N9    &kp N0    &kp MINUS
&kp TAB         &kp Q   &kp W     &kp E     &kp R      &kp T      &kp Y                              &kp U      &kp I          &kp O     &kp P     &kp LBKT
&mt LSHFT BSPC  &kp A   &kp S     &kp D     &kp F      &kp G      &kp H                              &kp J      &kp K          &kp L     &kp SEMI  &kp SQT
&mt LSHFT BSPC  &kp Z   &kp X     &kp C     &kp V      &kp B      &kp C_MUTE  &kp C_PLAY  &kp N      &kp M      &kp COMMA      &kp DOT   &kp FSLH  &mt RSHFT DEL
                        &kp LGUI  &kp LALT  &kp LCTRL  &mo LOWER  &kp RET     &kp SPACE   &mo RAISE  &kp RCTRL  &kp RIGHT_ALT  &kp RGUI
            >;

            sensor-bindings = <&scroll_vert &scroll_horz>;
        };

        lower_layer {
            display-name = "lower";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans  &kp F1     &kp F2        &kp F3     &kp F4      &kp F5                               &kp F6  &kp F7           &kp F8      &kp F9         &kp F10              &kp F11
&trans  &kp RA(Q)  &kp RA(RBKT)  &kp RA(E)  &backtick   &acute  &kp NON_US_HASH                      &kp RA(N7)       &kp RA(N8)  &kp RA(N9)     &kp RA(N0)           &kp F12
&trans  &kp RBKT   &kp LS(RBKT)  &caret     &kp LS(N0)  &trans  &kp RA(NON_US_BSLH)                  &kp NON_US_BSLH  &kp LS(N8)  &kp LS(N9)     &kp LS(NON_US_BSLH)  &kp LS(NON_US_HASH)
&trans  &kp FSLH   &kp LS(N7)    &kp LS(GRAVE)  &trans      &trans  &trans               &trans  &trans  &trans           &kp LS(N7)  &kp RA(MINUS)  &trans               &trans
                   &trans        &trans     &trans      &trans  &trans               &trans  &trans  &trans           &trans      &trans
            >;

            sensor-bindings = <&scroll_vert &inc_dec_kp C_PREV C_NEXT>;
        };

        raise_layer {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans  &kp LG(N1)      &kp LG(N2)         &kp LG(N3)          &kp LG(N4)        &kp LG(N5)                       &trans  &trans        &kp LC(HOME)  &trans         &trans  &trans
&trans  &kp LG(LS(S))   &kp LG(UP)         &kp LG(DOWN)        &kp LA(TAB)       &kp LA(F4)  &trans                   &kp LC(LEFT)  &kp UP        &kp LC(RIGHT)  &trans  &trans
&trans  &trans          &kp LG(LEFT)       &kp LG(RIGHT)       &kp LG(TAB)       &kp LG(Y)   &trans                   &kp LEFT      &kp DOWN      &kp RIGHT      &trans  &trans
&trans  &trans          &kp LG(LS(LEFT))   &kp LG(LS(RIGHT))   &kp LA(LS(TAB))   &kp LC(W)   &trans  &trans  &trans   &kp HOME      &kp LC(END)   &kp END        &trans  &trans
                    &trans     &trans      &trans       &trans  &trans  &trans  &trans  &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &scroll_horz>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&none       &none         &none         &none            &none            &none                            &none  &none  &none  &none  &none  &none
&none       &none         &none         &rgb_ug RGB_EFF  &rgb_ug RGB_TOG  &ext_power EP_TOG  &none                &none  &none  &none  &none  &none
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &none                &none  &none  &none  &none  &none
&bootloader  &none         &none         &none            &none            &studio_unlock     &none  &none  &none  &none  &none  &none  &none  &bootloader
                          &none         &none            &none            &none              &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
